---
config:
  theme: base
  themeVariables:
    background: "#ffffff"
    fontFamily: "Arial"
  flowchart:
    curve: linear
    htmlLabels: true
---
flowchart TB
    subgraph DECISION["01 · PROPOSED DESCHEDULER STATE GATE"]
      direction LR
      RB[("Assigned scheduling unit<br/>ResourceBinding + one target")]:::state
      EVIDENCE["Observe member state<br/>workload status or owned Pod conditions"]:::observe
      NORMALIZE["Normalize execution state<br/>phase · reason · started · generation"]:::observe
      ELIGIBLE{"Relocate?<br/>Not started + relocatable<br/>+ unschedulable beyond threshold"}:::gate
      KEEP["STOP · Keep placement<br/>Running · Terminal · Unknown<br/>or PartiallyRunning"]:::stop
      FENCE["Acquire pre-start admission fence<br/>then re-read observed revision"]:::action
      EVICT["GracefulEvictCluster(source)"]:::action
      POLICY[("Persistent relocation status<br/>attempt budget · source cooldown")]:::memory

      RB -->|current placement| EVIDENCE
      EVIDENCE -->|raw status or Pod signal| NORMALIZE
      NORMALIZE --> ELIGIBLE
      POLICY --> ELIGIBLE
      ELIGIBLE -->|No| KEEP
      ELIGIBLE -->|Yes| FENCE
      FENCE -->|state still NotStarted| EVICT
    end

    subgraph REQUEUE["02 · REVOKE PLACEMENT AND REQUEUE"]
      direction LR
      UPDATED[("Update ResourceBinding<br/>remove source + add eviction task")]:::state
      QUEUE["Re-enter scheduler queue<br/>legacy rate-limited or gated priority queue"]:::scheduler
      FILTER["ClusterEviction filter<br/>reject failed source"]:::scheduler
      SELECT["Select exactly one target<br/>using whole-task demand"]:::scheduler

      UPDATED -->|generation event| QUEUE
      QUEUE --> FILTER
      FILTER --> SELECT
    end

    subgraph HANDOFF["03 · PROPOSED LIFECYCLE-AWARE HANDOFF"]
      direction LR
      WORK["Create target Work<br/>retain or purge source by policy"]:::action
      START{"Trusted target state?"}:::gate
      CLEAN["Finish handoff<br/>clear task + delete old Work"]:::success
      HOLD["HOLD OR ROLLBACK<br/>Failed · Unknown · no target · timeout"]:::stop

      WORK -->|apply workload| START
      START -->|Running or Completed| CLEAN
      START -->|otherwise| HOLD
    end

    EVICT -->|spec update| UPDATED
    SELECT -->|new placement| WORK

    SCOPE["Scope boundary · whole task only<br/>without an admission fence, safety is best-effort"]:::note
    SCOPE -.-> ELIGIBLE

    classDef state fill:#f5f5f1,stroke:#111111,color:#111111,stroke-width:2px;
    classDef observe fill:#f7eadf,stroke:#d96724,color:#643015,stroke-width:2px;
    classDef gate fill:#fff7f6,stroke:#e63b2e,color:#641b15,stroke-width:3px;
    classDef stop fill:#f4f4f4,stroke:#6b7280,color:#374151,stroke-width:2px,stroke-dasharray:6 4;
    classDef memory fill:#fff5df,stroke:#d96724,color:#643015,stroke-width:2px;
    classDef action fill:#e6f3eb,stroke:#27845b,color:#123d2d,stroke-width:2px;
    classDef scheduler fill:#e2ebf5,stroke:#2563a6,color:#173b61,stroke-width:2px;
    classDef success fill:#e6f3eb,stroke:#27845b,color:#123d2d,stroke-width:3px;
    classDef note fill:#ffffff,stroke:#6b7280,color:#374151,stroke-width:2px,stroke-dasharray:6 4;
