---
config:
  theme: base
  themeVariables:
    background: "#ffffff"
    fontFamily: "Arial"
  flowchart:
    curve: basis
    htmlLabels: true
---
flowchart LR
    SOURCE["Source workload<br/>component replicas change"]:::source
    SNAPSHOT[("Accepted snapshot<br/>TargetCluster.Components")]:::state
    TRIGGER["#7830<br/>detect replica change"]:::changed
    SCHEDULER["Existing scheduler<br/>rescheduling path"]:::process
    ESTIMATE["#7835<br/>estimate positive delta<br/>or skip scale-down"]:::changed
    DECISION{"Scheduling<br/>accepted?"}:::process
    COMMIT["#7833<br/>persist accepted result"]:::state
    PROPAGATE["#7841<br/>allow latest Work update"]:::changed
    PRESERVE["#7841<br/>keep accepted result and Work"]:::risk

    SOURCE -->|desired spec.components| TRIGGER
    SNAPSHOT -->|accepted clusters[].components| TRIGGER
    TRIGGER -->|component replicas changed| SCHEDULER
    SCHEDULER -->|rescheduling request| ESTIMATE
    ESTIMATE -->|capacity result| DECISION
    DECISION -->|yes| COMMIT
    COMMIT -->|accepted source state| PROPAGATE
    DECISION -->|no| PRESERVE
    COMMIT -.->|next accepted baseline| SNAPSHOT

    classDef source fill:#dae8fc,stroke:#6c8ebf,color:#172554;
    classDef process fill:#f5f5f5,stroke:#666666,color:#262626;
    classDef state fill:#fff2cc,stroke:#d6b656,color:#713f12;
    classDef changed fill:#d5e8d4,stroke:#2f855a,color:#14532d,stroke-width:2px;
    classDef risk fill:#f8cecc,stroke:#b85450,color:#7f1d1d,stroke-dasharray:6 4;
